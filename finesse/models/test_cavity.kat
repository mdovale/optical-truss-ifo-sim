# Reference static FINESSE model for the Milestone 2 test cavity.
# Programmatic scans use finesse/templates/cavity_scan.kat.j2 instead.

l L0 P=1
gauss g0 L0.p1.o w0x=92e-6 w0y=92e-6 zx=0 zy=0
modes(maxtem=10)

s s_steer L0.p1 m_steer.p1 L=10m
m m_steer R=1 T=0 xbeta=0 ybeta=0
s s_in m_steer.p2 m1.p1 L=10m

m m1 R=0.99 T=0.01 Rc=0.5
s CAV m1.p2 m2.p1 L=0.1
m m2 R=0.99 T=0.01 Rc=-0.5

pd refl m1.p1.o

cavity cav source=m1.p2.o via=m2.p1.i priority=1

xaxis(L0.f, lin, -10M, 10M, 2001)
